@model List<electronic_gradebook.Models.Grade>

@{
    ViewData["Title"] = "Оценки";
}

<div class="container mt-4">
    <h1>Оценки</h1>
    <p>Списък с въведените оценки.</p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Ученик</th>
                <th>Предмет</th>
                <th>Оценка</th>
                <th>Дата</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center">
                        Все още няма въведени оценки.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var grade in Model)
                {
                    <tr>
                        <td>@(grade.Student?.Email ?? "Не е зададен")</td>
                        <td>@grade.Subject</td>
                        <td>@grade.Score</td>
                        <td>@grade.DateGiven.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>